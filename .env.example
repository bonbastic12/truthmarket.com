PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/truthmarket
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Browser origins allowed to call the API (comma separated) and the public address of the React app
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (1 on Render/Railway/nginx). Needed so rate limits count real visitor IPs.
TRUST_PROXY=0
CLIENT_URL=http://localhost:5173

# --- Chapa ---------------------------------------------------------------
# Use the TEST keys (CHASECK_TEST-...) first. Chapa dashboard > Settings > API.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx
# Chapa dashboard > Settings > Webhooks: set the URL to  <PUBLIC_API_URL>/api/webhook/chapa
# and choose a webhook secret. Put the same secret here.
CHAPA_WEBHOOK_SECRET=change-me-webhook-secret
# Public address of this API. Chapa must be able to reach it (use ngrok/cloudflared while developing).
PUBLIC_API_URL=https://your-public-api-address.example.com

# --- Money rules ----------------------------------------------------------
# These two only SEED the database the first time the API starts (the rates are then stored in the database and changed by an admin
# on the Commission & Revenue page; each order keeps the rates it was created with).
# 0.10 = 10% seller commission, taken from the seller's proceeds (10,000 ETB listing -> seller receives 9,000)
COMMISSION_RATE=0.10
# 0.05 = 5% buyer fee added on top of the price (10,000 ETB listing -> buyer pays 10,500). Never taken from the seller.
# Small sales: a listing priced under 1,000 ETB carries a flat 100 ETB buyer fee instead (150 ETB -> buyer pays 250). From 1,000 ETB up the percentage applies. (Constants in server/src/services/money.ts.)
BUYER_FEE_RATE=0.05
# Buyer inspection window after the seller reports the handover; funds auto-release when it ends without a dispute
INSPECTION_HOURS=48
# Unpaid orders release the reserved listing after this many minutes
PENDING_PAYMENT_MINUTES=30

# Exchange rate used for website revenue entered in USD (1 USD = ? ETB). Update it when the rate moves.
USD_TO_ETB=140

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@truthmarket.local
SEED_ADMIN_PASSWORD=ChangeMe12345

# --- Identity verification (National ID + phone + SMS code) ------------------
# 32 random bytes, base64. Encrypts ID photos and numbers. LOSING IT MAKES STORED IDs UNREADABLE; back it up safely.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=
# At least 32 characters. Used for ID fingerprints and OTP hashes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_HASH_KEY=
# Folder for encrypted ID photos. Keep it OUTSIDE any public folder and out of git.
KYC_STORAGE_DIR=./storage/kyc
# Accepted National ID number format (default: Fayda FIN, 16 digits)
KYC_ID_PATTERN=^\d{16}$

# SMS for the verification code. 'console' prints the code in the server log (development only, refused in production).
SMS_PROVIDER=console
# For real SMS: SMS_PROVIDER=afromessage and fill these from your Afro Message account
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=

# --- Real money switch ------------------------------------------------------------
# Keep this false (or unset) until Chapa TEST-mode payments, webhook and refunds have been tested end to end.
# With a live CHAPA_SECRET_KEY and this not set to true, the server refuses to start.
ENABLE_LIVE_PAYMENTS=false
# Smallest withdrawal in whole ETB
MIN_WITHDRAWAL_ETB=100

# --- Truth Market AI Assistant -------------------------------------------------------
# Server side only. Never put this key in the client or in any VITE_ variable. Leave empty to switch the assistant off.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
